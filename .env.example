BOTSHUB_LLM_BASE_URL=https://api.openai.com/v1
BOTSHUB_LLM_API_KEY=
BOTSHUB_LLM_MODEL=gpt-4o-mini
BOTSHUB_CRITIC_MODEL=mlx-community/gemma-4-e2b-it-4bit   # runs in-process on MLX (uv sync --extra local)
BOTSHUB_PRICE_IN=0.15            # $/Mtok, required for BOTSHUB_RUN_MAX_COST to trip
BOTSHUB_PRICE_OUT=0.60
BOTSHUB_RUN_MAX_COST=0.50
BOTSHUB_SEARXNG_URL=http://localhost:8888
GITHUB_TOKEN=
BOTSHUB_EMBED_MODEL=mlx-community/Qwen3-Embedding-0.6B-8bit   # empty disables semantic merge
BOTSHUB_EMBED_DIM=                # empty = auto-detect (1024 for Qwen3-Embedding-0.6B)
BOTSHUB_LLM_PARAMS=reasoning_effort=none   # comma-separated k=v; needed for reasoning models (tool calls + temperature)
